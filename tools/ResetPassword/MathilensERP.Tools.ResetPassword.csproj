<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MathilensERP.Tools.ResetPassword</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PasswordHasher<T> must be the *same* implementation and version the API uses, or the
         hash it produces will not verify at login. Microsoft.Extensions.Identity.Core 10.0.10
         is what Infrastructure pulls in transitively via Microsoft.AspNetCore.Identity.
         EntityFrameworkCore 10.0.10 — keep these two version numbers in step. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
