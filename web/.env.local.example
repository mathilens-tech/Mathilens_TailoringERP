# Copy to .env.local for local development (gitignored).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5232

# The shop this deployment is customised for — it is the wordmark on the login screen. Change it
# per customer; leave it out and the build falls back to the current one. Read at build time, so a
# change needs a rebuild, not just a restart.
NEXT_PUBLIC_CUSTOMER_NAME=Radha Men's
