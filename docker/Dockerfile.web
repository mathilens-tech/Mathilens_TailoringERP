# Mathilens Tailoring ERP — web image.
#
# Builds the Next.js static export and serves it from nginx, which also proxies /api/ to the API
# container so the browser only ever talks to one origin.

FROM node:22-alpine AS build
WORKDIR /src

# Lockfile first, for the same reason the API copies csproj files first: dependencies change far
# less often than source, and npm ci is the slow half of this build.
COPY web/package.json web/package-lock.json web/
RUN npm --prefix web ci

COPY web/ web/
COPY deploy/test-server/generate-nginx-routes.mjs deploy/test-server/

# Both are compiled into the client bundle by `next build`, so they are build arguments rather than
# runtime environment: changing either needs a rebuild, not a restart. Passing them at runtime is a
# silent no-op, which is the confusing way this gets got wrong.
#
# The API base URL is the site's own origin — nginx below proxies /api/ to the API container, so
# there is no second hostname and no cross-origin call.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_CUSTOMER_NAME
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_CUSTOMER_NAME=$NEXT_PUBLIC_CUSTOMER_NAME

RUN npm --prefix web run build

# Generated here rather than on the server: the rules come from web/staticwebapp.config.json, which
# is in this build context, and generating them at image build time means the image is complete on
# its own instead of depending on a step someone has to remember to run beside it.
RUN node deploy/test-server/generate-nginx-routes.mjs web/staticwebapp.config.json \
    > /tmp/mathilens-routes.conf

FROM nginx:1.27-alpine AS runtime

COPY --from=build /src/web/out                 /var/www/mathilens
COPY --from=build /tmp/mathilens-routes.conf   /etc/nginx/mathilens-routes.conf
COPY docker/nginx.conf                         /etc/nginx/conf.d/default.conf

EXPOSE 80
