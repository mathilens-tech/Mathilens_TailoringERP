# Mathilens Tailoring ERP — API image.
#
# Was a comment-only placeholder, which meant Coolify had nothing to build: the "dockerfile" build
# pack found a file with no FROM and failed before it started. The test stack on mathilens-test-vm
# needs a real one.
#
# The build context is the repository root, not this directory — Directory.Build.props sits there
# and carries <TargetFramework>net10.0</TargetFramework> for every project. Building from docker/
# would restore against a missing props file and silently target the SDK's default instead.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore before the rest of the source is copied, so a change to a .cs file does not invalidate
# the restore layer. Directory.Build.props and the solution are part of the graph, so they have to
# come too — restoring with only the .csproj would miss the target framework.
COPY Directory.Build.props MathilensERP.slnx ./
COPY src/ ./src/
RUN dotnet restore src/Api/MathilensERP.Api.csproj

RUN dotnet publish src/Api/MathilensERP.Api.csproj \
      --configuration Release \
      --no-restore \
      --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .

# 8080, which is what Coolify's proxy expects to find and what the platform's own default is on
# .NET 8 and later. Named explicitly rather than relied upon: the value differs between base image
# versions, and a silent change would leave the container healthy and unreachable.
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Behind Coolify's Traefik the API sees a plain HTTP hop, exactly as it does behind nginx on the
# old test box. Without this, app.UseHttpsRedirection() answers 307 to HTTPS, the proxy forwards it
# back as HTTP, and the browser loops. See deploy/test-server/README.md, "Forwarded headers".
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# MathilensERP.Api.dll, not Mathilens.Api.dll. The assembly takes its name from the project file
# and there is no <AssemblyName> override; the older name is still sitting in production's wwwroot
# from a previous deployment, which is what made the host unable to choose between the two.
ENTRYPOINT ["dotnet", "MathilensERP.Api.dll"]
